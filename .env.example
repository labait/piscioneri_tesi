# OpenAI Configuration (per il chatbot principale)
VITE_OPENAI_API_KEY=sk-your-openai-api-key-here
VITE_OPENAI_ASSISTANT_ID=asst_your-assistant-id-here

# Airtable Configuration (per salvare le conversazioni)
VITE_AIRTABLE_API_KEY=your-airtable-api-key-here
VITE_AIRTABLE_BASE_ID=your-airtable-base-id-here
VITE_AIRTABLE_TABLE_NAME=your-table-name-here

# Google Gemini Configuration (per analisi immagini e generazione contenuti)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud / Vertex AI Configuration (per Imagen 4.0 image editing)
# IMPORTANTE: Queste vanno configurate su Netlify, NON nel file .env locale
# Vedere IMAGEN_SETUP.md per istruzioni dettagliate

# GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
